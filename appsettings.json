{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelRouterApi": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://make.powerautomate.com",
    "https://copilotstudio.microsoft.com"
  ],
  "ModelRouter": {
    "AzureOpenAi": {
      "Endpoint": "https://<your-resource>.openai.azure.com/",
      "ApiKey": "<your-api-key>",
      "ApiVersion": "2025-01-01-preview",
      "FastModelDeployment":      "gpt-4o-mini",
      "ModerateModelDeployment":  "gpt-4.1-mini",
      "ReasoningModelDeployment": "gpt-4o",
      "ComplexModelDeployment":   "gpt-4.1",
      "CriticalModelDeployment":  "o4-mini",
      "EmbeddingModelDeployment": "text-embedding-3-small"
    },
    "RoutingThresholds": {
      "SimpleTokenThreshold":     20,
      "ModerateTokenThreshold":   60,
      "AnalyticalTokenThreshold": 150,
      "MinConfidenceThreshold":   0.6
    },
    "ModelCosts": {
      "FastModelCostPer1KTokens":      0.00015,
      "ModerateModelCostPer1KTokens":  0.0004,
      "ReasoningModelCostPer1KTokens": 0.005,
      "ComplexModelCostPer1KTokens":   0.008,
      "CriticalModelCostPer1KTokens":  0.011,
      "EmbeddingModelCostPer1KTokens": 0.00002
    },
    "Telemetry": {
      "EnableDetailedLogging": true,
      "ApplicationInsightsConnectionString": ""
    }
  }
}
